<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Authors>Daniel Mendonça</Authors>

		<Company>Valuto-MG</Company>

		<Description>Biblioteca de Trilha de Auditoria para Entity Framework Core com Rabbit.</Description>

		<Copyright>Copyright © 2026</Copyright>
	</PropertyGroup>

	<PropertyGroup>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeAbstractionsInPackage</TargetsForTfmSpecificBuildOutput>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>false</IncludeSymbols>

		<DebugSymbols>false</DebugSymbols>
		<DebugType>none</DebugType>
		<Optimize>true</Optimize>

		<SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="6.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Valuto.AuditTrail.Abstractions\Valuto.AuditTrail.Abstractions.csproj">
			<PrivateAssets>all</PrivateAssets>
			<ReferenceOutputAssembly>true</ReferenceOutputAssembly>
		</ProjectReference>

		<ProjectReference Include="..\..\Valuto.AuditTrail.Logic\Valuto.AuditTrail.Logic.csproj">
			<PrivateAssets>all</PrivateAssets>
			<ReferenceOutputAssembly>true</ReferenceOutputAssembly>
		</ProjectReference>
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<Target Name="IncludeInternalLibsInPackage" DependsOnTargets="Build">
		<ItemGroup>
			<BuildOutputInPackage Include="$(OutputPath)Valuto.AuditTrail.Abstractions.dll" />
			<BuildOutputInPackage Include="$(OutputPath)Valuto.AuditTrail.Abstractions.xml" />
			<BuildOutputInPackage Include="$(OutputPath)Valuto.AuditTrail.Logic.dll" />
			<BuildOutputInPackage Include="$(OutputPath)Valuto.AuditTrail.Logic.xml" />
		</ItemGroup>
	</Target>

</Project>
