<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>Valuto.AuditTrail.EFCore</id>
    <version>1.0.0</version>
    <authors>Daniel Mendonça</authors>
    <description>Biblioteca de Trilha de Auditoria para Entity Framework Core com Rabbit.</description>
    <copyright>Copyright © 2026</copyright>
    
    <dependencies>
      <group targetFramework="netcoreapp3.1">
        <dependency id="Valuto.AuditTrail.Abstractions" version="1.0.0" />
        <dependency id="Microsoft.EntityFrameworkCore" version="3.1.0" />
        <dependency id="Microsoft.Extensions.Hosting.Abstractions" version="3.1.0" />
        <dependency id="Microsoft.Extensions.DependencyInjection.Abstractions" version="3.1.0" />
        <dependency id="Microsoft.Bcl.AsyncInterfaces" version="1.1.0" />
        <dependency id="Microsoft.Extensions.Options" version="3.1.0" />
        <dependency id="MassTransit" version="6.3.2" />
        <dependency id="MassTransit.RabbitMQ" version="6.3.2" />
      </group>

      <group targetFramework="net6.0">
        <dependency id="Valuto.AuditTrail.Abstractions" version="1.0.0" />
        <dependency id="Microsoft.EntityFrameworkCore" version="6.0.0" />
        <dependency id="Microsoft.Extensions.Hosting.Abstractions" version="6.0.0" />
        <dependency id="Microsoft.Extensions.DependencyInjection.Abstractions" version="7.0.0" />
        <dependency id="Microsoft.Bcl.AsyncInterfaces" version="6.0.0" />
        <dependency id="Microsoft.Extensions.Options" version="6.0.0" />
        <dependency id="MassTransit" version="7.3.1" />
        <dependency id="MassTransit.RabbitMQ" version="7.3.1" />
      </group>

      <group targetFramework="net7.0">
        <dependency id="Valuto.AuditTrail.Abstractions" version="1.0.0" />
        <dependency id="Microsoft.EntityFrameworkCore" version="7.0.0" />
        <dependency id="Microsoft.Extensions.Hosting.Abstractions" version="7.0.0" />
        <dependency id="Microsoft.Extensions.DependencyInjection.Abstractions" version="7.0.0" />
        <dependency id="Microsoft.Bcl.AsyncInterfaces" version="7.0.0" />
        <dependency id="Microsoft.Extensions.Options" version="7.0.0" />
        <dependency id="MassTransit" version="7.3.1" />
        <dependency id="MassTransit.RabbitMQ" version="7.3.1" />
      </group>

      <group targetFramework="net8.0">
        <dependency id="Valuto.AuditTrail.Abstractions" version="1.0.0" />
        <dependency id="Microsoft.EntityFrameworkCore" version="8.0.0" />
        <dependency id="Microsoft.Extensions.Hosting.Abstractions" version="8.0.0" />
        <dependency id="Microsoft.Extensions.DependencyInjection.Abstractions" version="8.0.0" />
        <dependency id="Microsoft.Bcl.AsyncInterfaces" version="8.0.0" />
        <dependency id="Microsoft.Extensions.Options" version="8.0.0" />
        <dependency id="MassTransit" version="8.2.5" />
        <dependency id="MassTransit.RabbitMQ" version="8.2.5" />
      </group>
    </dependencies>
  </metadata>

  <files>
    <file src="README.md" target="" />

    <file src="bin\$configuration$\netcoreapp3.1\Valuto.AuditTrail.EFCore.dll" target="lib\netcoreapp3.1" />
    <file src="bin\$configuration$\net6.0\Valuto.AuditTrail.EFCore.dll" target="lib\net6.0" />
    <file src="bin\$configuration$\net7.0\Valuto.AuditTrail.EFCore.dll" target="lib\net7.0" />
    <file src="bin\$configuration$\net8.0\Valuto.AuditTrail.EFCore.dll" target="lib\net8.0" />

    <file src="bin\$configuration$\netcoreapp3.1\Valuto.AuditTrail.Logic.dll" target="build\netcoreapp3.1\private" />
    <file src="bin\$configuration$\netcoreapp3.1\Valuto.AuditTrail.Mesaging.dll" target="build\netcoreapp3.1\private" />
    
    <file src="bin\$configuration$\net6.0\Valuto.AuditTrail.Logic.dll" target="build\net6.0\private" />
    <file src="bin\$configuration$\net6.0\Valuto.AuditTrail.Mesaging.dll" target="build\net6.0\private" />
    
    <file src="bin\$configuration$\net7.0\Valuto.AuditTrail.Logic.dll" target="build\net7.0\private" />
    <file src="bin\$configuration$\net7.0\Valuto.AuditTrail.Mesaging.dll" target="build\net7.0\private" />
    
    <file src="bin\$configuration$\net8.0\Valuto.AuditTrail.Logic.dll" target="build\net8.0\private" />
    <file src="bin\$configuration$\net8.0\Valuto.AuditTrail.Mesaging.dll" target="build\net8.0\private" />

    <file src="Valuto.AuditTrail.EFCore.targets" target="build" />
    <file src="Valuto.AuditTrail.EFCore.targets" target="buildTransitive" />
  </files>
</package>