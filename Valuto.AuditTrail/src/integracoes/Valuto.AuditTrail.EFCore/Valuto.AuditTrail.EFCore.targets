<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <_ValutoActualDir>$(MSBuildThisFileDirectory)</_ValutoActualDir>
    <_ValutoActualDir Condition="$(MSBuildThisFileDirectory.Contains('buildTransitive'))">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\build\'))</_ValutoActualDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Valuto.AuditTrail.Logic">
      <HintPath>$(_ValutoActualDir)$(TargetFramework)\private\Valuto.AuditTrail.Logic.dll</HintPath>
      <Private>true</Private>
      <Visible>false</Visible>
    </Reference>

    <Reference Include="Valuto.AuditTrail.Mesaging">
      <HintPath>$(_ValutoActualDir)$(TargetFramework)\private\Valuto.AuditTrail.Mesaging.dll</HintPath>
      <Private>true</Private>
      <Visible>false</Visible>
    </Reference>
  </ItemGroup>
</Project>