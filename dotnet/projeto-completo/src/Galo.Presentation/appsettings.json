{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Frontend": {
    "Origin": "http://localhost:4300"
  },

  "Auth": {
    "Enforce": true
  },

  "Database": {
    "MigrateOnStartup": false
  },

  "RabbitMQ": {
    "Exchange": "galo.eventos",
    "Queue": "galo.api.eventos",
    "Prefetch": 8,
    "Habilitado": true
  }
}
